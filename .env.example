
# --- API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
APIFY_TOKEN=your_apify_token_here
APIFY_TOKEN_BACKUP=your_apify_backup_token_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- Vision (CASC-01: single provider) ---
# The image-description cascade is pure Bailian qwen3-vl-flash. Only
# BAILIAN_API_KEY is required for the vision path. SILICONFLOW_API_KEY /
# OPENROUTER_API_KEY / OMNIGRAPH_GEMINI_KEY are no longer read by
# lib/vision_cascade.py or image_pipeline.py -- you can drop them.
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_VISION_MODEL=qwen3-vl-flash

# --- Configuration ---
# CDP_URL: browser scraping fallback for ingest_wechat.py
# Production default — local Edge with remote debugging enabled:
#   msedge --remote-debugging-port=9223
#   CDP_URL=http://localhost:9223
#
# Local testing fallback — remote Playwright MCP server (when no local Edge available):
#   CDP_URL=http://host:port/mcp
#   NOTE: ingest_wechat.py currently uses connect_over_cdp() (local only).
#         MCP client support for this path is not yet implemented.
CDP_URL=http://localhost:9223
