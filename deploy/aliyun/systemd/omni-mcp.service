[Unit]
Description=OmniGraph MCP Server (kb-api proxy)
After=network.target omni-kb-api.service
Wants=omni-kb-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/OmniGraph-Vault
Environment=KB_API_URL=http://127.0.0.1:8766
ExecStart=/root/OmniGraph-Vault/venv-aim1/bin/python3 /root/OmniGraph-Vault/mcp_server_standalone.py
Restart=always
RestartSec=10
MemoryHigh=512M
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
