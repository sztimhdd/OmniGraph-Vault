[Unit]
Description=OmniGraph daily ingest pipeline summary (Telegram digest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/OmniGraph-Vault
ExecStart=/root/OmniGraph-Vault/venv-aim1/bin/python3 /root/OmniGraph-Vault/scripts/ingest_daily_summary.py
StandardOutput=journal
StandardError=journal
