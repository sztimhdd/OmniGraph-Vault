[Unit]
Description=OmniGraph daily ingest 09:00 ADT (12:00 UTC)
After=network-online.target
Wants=network-online.target
Conflicts=omnigraph-afternoon-ingest.service omnigraph-evening-ingest.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/OmniGraph-Vault
EnvironmentFile=/root/.hermes/.env
TimeoutStartSec=300
# 2026-09-24: cache initialization exceeded 3G and stalled in cgroup reclaim.
MemoryHigh=5G
MemoryMax=6G
OOMScoreAdjust=900
Restart=no
ExecStartPre=/root/OmniGraph-Vault/venv-aim1/bin/python /root/OmniGraph-Vault/scripts/cleanup_stuck_docs.py --dry-run
ExecStart=/root/OmniGraph-Vault/venv-aim1/bin/python /root/OmniGraph-Vault/batch_ingest_from_spider.py --from-db --max-articles 10 --batch-timeout 6300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
