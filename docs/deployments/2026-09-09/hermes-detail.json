  "sources": {
    "deploy/sync_kq_to_new.py": [
      {
        "line": 1,
        "text": "#!/usr/bin/env python3"
      },
      {
        "line": 2,
        "text": "\"\"\"sync_kq_to_new.py — incremental KG + SQLite sync from old machine to new MCP machine."
      },
      {
        "line": 3,
        "text": ""
      },
      {
        "line": 4,
        "text": "Run ON THE OLD MACHINE. Both machines run the same bge-m3 1024d embeddings, so"
      },
      {
        "line": 5,
        "text": "vectors are copied as-is (no re-embedding)."
      },
      {
        "line": 6,
        "text": ""
      },
      {
        "line": 7,
        "text": "Strategy:"
      },
      {
        "line": 8,
        "text": "- KG (Qdrant): point-ID diff. Scroll ALL point IDs on both machines, diff"
      },
      {
        "line": 9,
        "text": "  (old - new), fetch missing points (vector+payload) from old, upsert to new."
      },
      {
        "line": 10,
        "text": "  Idempotent by construction; no watermark file needed."
      },
      {
        "line": 11,
        "text": "- SQLite (kol_scan.db): full .backup on old, scp to new, atomic replace"
      },
      {
        "line": 12,
        "text": "  (new machine's copy is read-only for FTS — verified)."
      },
      {
        "line": 13,
        "text": ""
      },
      {
        "line": 14,
        "text": "Exit code: 0 = sync complete, 1 = failure (for systemd OnFailure alerting)."
      },
      {
        "line": 15,
        "text": "\"\"\""
      },
      {
        "line": 16,
        "text": "import json"
      },
      {
        "line": 17,
        "text": "import os"
      },
      {
        "line": 18,
        "text": "import shutil"
      },
      {
        "line": 19,
        "text": "import subprocess"
      },
      {
        "line": 20,
        "text": "import sys"
      },
      {
        "line": 21,
        "text": "import time"
      },
      {
        "line": 22,
        "text": ""
      },
      {
        "line": 23,
        "text": "OLD_QDRANT = \"http://127.0.0.1:6333\""
      },
      {
        "line": 24,
        "text": "NEW_QDRANT = \"http://127.0.0.1:16333\"  # via SSH tunnel below (public 6333 not open)"
      },
      {
        "line": 25,
        "text": "NEW_SSH = os.environ.get(\"SYNC_NEW_SSH\", \"root@47.103.73.20\")"
      },
      {
        "line": 26,
        "text": "TUNNEL_PORT = 16333"
      },
      {
        "line": 27,
        "text": "DB = \"/root/OmniGraph-Vault/data/kol_scan.db\""
      },
      {
        "line": 28,
        "text": "COLLECTIONS = [\"entities\", \"chunks\", \"relationships\"]"
      },
      {
        "line": 29,
        "text": "PAGE = 1000"
      },
      {
        "line": 30,
        "text": "UPSERT_BATCH = 512"
      },
      {
        "line": 31,
        "text": "LOG = \"/var/log/omnigraph-kg-sync.log\""
      },
      {
        "line": 32,
        "text": ""
      },
      {
        "line": 33,
        "text": ""
      },
      {
        "line": 34,
        "text": "def start_tunnel() -> subprocess.Popen:"
      },
      {
        "line": 35,
        "text": "    \"\"\"SSH local-forward tunnel: 127.0.0.1:16333 -> new:6333.\"\"\""
      },
      {
        "line": 36,
        "text": "    proc = subprocess.Popen("
      },
      {
        "line": 37,
        "text": "        ["
      },
      {
        "line": 38,
        "text": "            \"ssh\","
      },
      {
        "line": 39,
        "text": "            \"-N\","
      },
      {
        "line": 40,
        "text": "            \"-o\","
      },
      {
        "line": 41,
        "text": "            \"ConnectTimeout=15\","
      },
      {
        "line": 42,
        "text": "            \"-o\","
      },
      {
        "line": 43,
        "text": "            \"StrictHostKeyChecking=no\","
      },
      {
        "line": 44,
        "text": "            \"-o\","
      },
      {
        "line": 45,
        "text": "            \"ServerAliveInterval=30\","
      },
      {
        "line": 46,
        "text": "            \"-L\","
      },
      {
        "line": 47,
        "text": "            f\"{TUNNEL_PORT}:127.0.0.1:6333\","
      },
      {
        "line": 48,
        "text": "            NEW_SSH,"
      },
      {
        "line": 49,
        "text": "        ],"
      },
      {
        "line": 50,
        "text": "        stdout=subprocess.DEVNULL,"
      },
      {
        "line": 51,
        "text": "        stderr=subprocess.DEVNULL,"
      },
      {
        "line": 52,
        "text": "    )"
      },
      {
        "line": 53,
        "text": "    # wait for port to open"
      },
      {
        "line": 54,
        "text": "    for _ in range(20):"
      },
      {
        "line": 55,
        "text": "        import socket"
      },
      {
        "line": 56,
        "text": ""
      },
      {
        "line": 57,
        "text": "        s = socket.socket()"
      },
      {
        "line": 58,
        "text": "        try:"
      },
      {
        "line": 59,
        "text": "            s.connect((\"127.0.0.1\", TUNNEL_PORT))"
      },
      {
        "line": 60,
        "text": "            s.close()"
      },
      {
        "line": 61,
        "text": "            return proc"
      },
      {
        "line": 62,
        "text": "        except OSError:"
      },
      {
        "line": 63,
        "text": "            time.sleep(1)"
      },
      {
        "line": 64,
        "text": "    log(f\"FATAL: tunnel to {NEW_SSH} did not open\")"
      },
      {
        "line": 65,
        "text": "    proc.terminate()"
      },
      {
        "line": 66,
        "text": "    sys.exit(1)"
      },
      {
        "line": 67,
        "text": ""
      },
      {
        "line": 68,
        "text": ""
      },
      {
        "line": 69,
        "text": "def log(msg: str) -> None:"
      },
      {
        "line": 70,
        "text": "    line = f\"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\""
      },
      {
        "line": 71,
        "text": "    print(line, flush=True)"
      },
      {
        "line": 72,
        "text": "    with open(LOG, \"a\") as f:"
      },
      {
        "line": 73,
        "text": "        f.write(line + \"\\n\")"
      },
      {
        "line": 74,
        "text": ""
      },
      {
        "line": 75,
        "text": ""
      },
      {
        "line": 76,
        "text": "def scroll_ids(url: str, coll: str) -> set:"
      },
      {
        "line": 77,
        "text": "    \"\"\"Scroll all point IDs of a collection. Returns set of str IDs.\"\"\""
      },
      {
        "line": 78,
        "text": "    import urllib.request"
      },
      {
        "line": 79,
        "text": ""
      },
      {
        "line": 80,
        "text": "    ids: set = set()"
      },
      {
        "line": 81,
        "text": "    offset = None"
      },
      {
        "line": 82,
        "text": "    while True:"
      },
      {
        "line": 83,
        "text": "        body = {\"with_payload\": False, \"with_vector\": False, \"limit\": PAGE}"
      },
      {
        "line": 84,
        "text": "        if offset is not None:"
      },
      {
        "line": 85,
        "text": "            body[\"offset\"] = offset"
      },
      {
        "line": 86,
        "text": "        req = urllib.request.Request("
      },
      {
        "line": 87,
        "text": "            f\"{url}/collections/{coll}/points/scroll\","
      },
      {
        "line": 88,
        "text": "            data=json.dumps(body).encode(),"
      },
      {
        "line": 89,
        "text": "            headers={\"Content-Type\": \"application/json\"},"
      },
      {
        "line": 90,
        "text": "        )"
      },
      {
        "line": 91,
        "text": "        with urllib.request.urlopen(req, timeout=60) as resp:"
      },
      {
        "line": 92,
        "text": "            data = json.loads(resp.read())"
      },
      {
        "line": 93,
        "text": "        pts = data.get(\"result\", {}).get(\"points\", [])"
      },
      {
        "line": 94,
        "text": "        for p in pts:"
      },
      {
        "line": 95,
        "text": "            ids.add(p[\"id\"])"
      },
      {
        "line": 96,
        "text": "        nxt = data.get(\"result\", {}).get(\"next_page_offset\")"
      },
      {
        "line": 97,
        "text": "        if not nxt:"
      },
      {
        "line": 98,
        "text": "            break"
      },
      {
        "line": 99,
        "text": "        offset = nxt"
      },
      {
        "line": 100,
        "text": "    return ids"
      },
      {
        "line": 101,
        "text": ""
      },
      {
        "line": 102,
        "text": ""
      },
      {
        "line": 103,
        "text": "def fetch_points(url: str, coll: str, ids: list) -> list:"
      },
      {
        "line": 104,
        "text": "    \"\"\"Fetch full points (vector+payload) for given IDs from old machine.\"\"\""
      },
      {
        "line": 105,
        "text": "    import urllib.request"
      },
      {
        "line": 106,
        "text": ""
      },
      {
        "line": 107,
        "text": "    out = []"
      },
      {
        "line": 108,
        "text": "    for i in range(0, len(ids), 512):"
      },
      {
        "line": 109,
        "text": "        chunk = ids[i : i + 512]"
      },
      {
        "line": 110,
        "text": "        body = {\"ids\": chunk, \"with_payload\": True, \"with_vector\": True}"
      },
      {
        "line": 111,
        "text": "        req = urllib.request.Request("
      },
      {
        "line": 112,
        "text": "            f\"{url}/collections/{coll}/points\","
      },
      {
        "line": 113,
        "text": "            data=json.dumps(body).encode(),"
      },
      {
        "line": 114,
        "text": "            headers={\"Content-Type\": \"application/json\"},"
      },
      {
        "line": 115,
        "text": "        )"
      },
      {
        "line": 116,
        "text": "        with urllib.request.urlopen(req, timeout=120) as resp:"
      },
      {
        "line": 117,
        "text": "            data = json.loads(resp.read())"
      },
      {
        "line": 118,
        "text": "        out.extend(data.get(\"result\", []))"
      },
      {
        "line": 119,
        "text": "    return out"
      },
      {
        "line": 120,
        "text": ""
      },
      {
        "line": 121,
        "text": ""
      },
      {
        "line": 122,
        "text": "def upsert(url: str, coll: str, points: list, retries: int = 3) -> bool:"
      },
      {
        "line": 123,
        "text": "    \"\"\"Upsert points to new machine with retry+backoff.\"\"\""
      },
      {
        "line": 124,
        "text": "    import urllib.request"
      },
      {
        "line": 125,
        "text": ""
      },
      {
        "line": 126,
        "text": "    for attempt in range(1, retries + 1):"
      },
      {
        "line": 127,
        "text": "        try:"
      },
      {
        "line": 128,
        "text": "            body = {\"points\": points}"
      },
      {
        "line": 129,
        "text": "            req = urllib.request.Request("
      },
      {
        "line": 130,
        "text": "                f\"{url}/collections/{coll}/points\","
      },
      {
        "line": 131,
        "text": "                data=json.dumps(body).encode(),"
      },
      {
        "line": 132,
        "text": "                headers={\"Content-Type\": \"application/json\"},"
      },
      {
        "line": 133,
        "text": "                method=\"PUT\","
      },
      {
        "line": 134,
        "text": "            )"
      },
      {
        "line": 135,
        "text": "            with urllib.request.urlopen(req, timeout=180) as resp:"
      },
      {
        "line": 136,
        "text": "                if resp.status == 200:"
      },
      {
        "line": 137,
        "text": "                    return True"
      },
      {
        "line": 138,
        "text": "        except Exception as e:"
      },
      {
        "line": 139,
        "text": "            log(f\"  upsert attempt {attempt}/{retries} failed: {e}\")"
      },
      {
        "line": 140,
        "text": "            time.sleep(5 * attempt)"
      },
      {
        "line": 141,
        "text": "    return False"
      },
      {
        "line": 142,
        "text": ""
      },
      {
        "line": 143,
        "text": ""
      },
      {
        "line": 144,
        "text": "def sync_collection(coll: str) -> None:"
      },
      {
        "line": 145,
        "text": "    from qdrant_client import QdrantClient"
      },
      {
        "line": 146,
        "text": ""
      },
      {
        "line": 147,
        "text": "    name = f\"lightrag_vdb_{coll}_bge_m3_1024d\""
      },
      {
        "line": 148,
        "text": "    log(f\"[{coll}] scrolling IDs (old={OLD_QDRANT}, new={NEW_QDRANT})...\")"
      },
      {
        "line": 149,
        "text": "    old_ids = scroll_ids(OLD_QDRANT, name)"
      },
      {
        "line": 150,
        "text": "    new_ids = scroll_ids(NEW_QDRANT, name)"
      },
      {
        "line": 151,
        "text": "    diff = old_ids - new_ids"
      },
      {
        "line": 152,
        "text": "    log(f\"[{coll}] old={len(old_ids)} new={len(new_ids)} diff={len(diff)}\")"
      },
      {
        "line": 153,
        "text": "    if not diff:"
      },
      {
        "line": 154,
        "text": "        log(f\"[{coll}] up to date, nothing to sync\")"
      },
      {
        "line": 155,
        "text": "        return"
      },
      {
        "line": 156,
        "text": ""
      },
      {
        "line": 157,
        "text": "    # Fetch from old in chunks"
      },
      {
        "line": 158,
        "text": "    id_list = sorted(diff)"
      },
      {
        "line": 159,
        "text": "    missing = 0"
      },
      {
        "line": 160,
        "text": "    for i in range(0, len(id_list), UPSERT_BATCH):"
      },
      {
        "line": 161,
        "text": "        chunk_ids = id_list[i : i + UPSERT_BATCH]"
      },
      {
        "line": 162,
        "text": "        pts = fetch_points(OLD_QDRANT, name, chunk_ids)"
      },
      {
        "line": 163,
        "text": "        # Qdrant may return fewer than requested if some IDs vanished"
      },
      {
        "line": 164,
        "text": "        got = {p[\"id\"] for p in pts}"
      },
      {
        "line": 165,
        "text": "        missing += len(chunk_ids) - len(got)"
      },
      {
        "line": 166,
        "text": "        clean = ["
      },
      {
        "line": 167,
        "text": "            {"
      },
      {
        "line": 168,
        "text": "                \"id\": p[\"id\"],"
      },
      {
        "line": 169,
        "text": "                \"vector\": p.get(\"vector\"),"
      },
      {
        "line": 170,
        "text": "                \"payload\": p.get(\"payload\") or {},"
      },
      {
        "line": 171,
        "text": "            }"
      },
      {
        "line": 172,
        "text": "            for p in pts"
      },
      {
        "line": 173,
        "text": "            if p.get(\"vector\") is not None"
      },
      {
        "line": 174,
        "text": "        ]"
      },
      {
        "line": 175,
        "text": "        if not clean:"
      },
      {
        "line": 176,
        "text": "            continue"
      },
      {
        "line": 177,
        "text": "        if not upsert(NEW_QDRANT, name, clean):"
      },
      {
        "line": 178,
        "text": "            log(f\"[{coll}] FATAL upsert failed at chunk {i}; aborting\")"
      },
      {
        "line": 179,
        "text": "            sys.exit(1)"
      },
      {
        "line": 180,
        "text": "        log(f\"[{coll}] +{len(clean)} upserted (chunk {i // UPSERT_BATCH + 1}/{(len(id_list) - 1) // UPSERT_BATCH + 1})\")"
      },
      {
        "line": 181,
        "text": "    log(f\"[{coll}] done. diff={len(diff)} missing={missing}\")"
      },
      {
        "line": 182,
        "text": ""
      },
      {
        "line": 183,
        "text": ""
      },
      {
        "line": 184,
        "text": "def sync_sqlite() -> None:"
      },
      {
        "line": 185,
        "text": "    \"\"\"Full kol_scan.db backup on old, scp to new, atomic replace.\"\"\""
      },
      {
        "line": 186,
        "text": "    import urllib.request"
      },
      {
        "line": 187,
        "text": ""
      },
      {
        "line": 188,
        "text": "    tmp = \"/tmp/kol_scan.db.bak\""
      },
      {
        "line": 189,
        "text": "    subprocess.run("
      },
      {
        "line": 190,
        "text": "        [\"sqlite3\", DB, f\".backup '{tmp}'\"], check=True, timeout=300"
      },
      {
        "line": 191,
        "text": "    )"
      },
      {
        "line": 192,
        "text": "    size = os.path.getsize(tmp)"
      },
      {
        "line": 193,
        "text": "    log(f\"[sqlite] backup {size} bytes, scp to {NEW_SSH}...\")"
      },
      {
        "line": 194,
        "text": "    subprocess.run("
      },
      {
        "line": 195,
        "text": "        ["
      },
      {
        "line": 196,
        "text": "            \"scp\","
      },
      {
        "line": 197,
        "text": "            \"-o\","
      },
      {
        "line": 198,
        "text": "            \"ConnectTimeout=15\","
      },
      {
        "line": 199,
        "text": "            \"-o\","
      },
      {
        "line": 200,
        "text": "            \"StrictHostKeyChecking=no\","
      },
      {
        "line": 201,
        "text": "            tmp,"
      },
      {
        "line": 202,
        "text": "            f\"{NEW_SSH}:/tmp/kol_scan.db.new\","
      },
      {
        "line": 203,
        "text": "        ],"
      },
      {
        "line": 204,
        "text": "        check=True,"
      },
      {
        "line": 205,
        "text": "        timeout=600,"
      },
      {
        "line": 206,
        "text": "    )"
      },
      {
        "line": 207,
        "text": "    # Atomic replace on new machine"
      },
      {
        "line": 208,
        "text": "    subprocess.run("
      },
      {
        "line": 209,
        "text": "        ["
      },
      {
        "line": 210,
        "text": "            \"ssh\","
      },
      {
        "line": 211,
        "text": "            \"-o\","
      },
      {
        "line": 212,
        "text": "            \"ConnectTimeout=15\","
      },
      {
        "line": 213,
        "text": "            NEW_SSH,"
      },
      {
        "line": 214,
        "text": "            \"mv /tmp/kol_scan.db.new /root/OmniGraph-Vault/data/kol_scan.db && \""
      },
      {
        "line": 215,
        "text": "            \"ls -la /root/OmniGraph-Vault/data/kol_scan.db\","
      },
      {
        "line": 216,
        "text": "        ],"
      },
      {
        "line": 217,
        "text": "        check=True,"
      },
      {
        "line": 218,
        "text": "        timeout=120,"
      },
      {
        "line": 219,
        "text": "    )"
      },
      {
        "line": 220,
        "text": "    os.remove(tmp)"
      },
      {
        "line": 221,
        "text": "    log(f\"[sqlite] replaced on new machine\")"
      },
      {
        "line": 222,
        "text": ""
      },
      {
        "line": 223,
        "text": ""
      },
      {
        "line": 224,
        "text": "def main() -> None:"
      },
      {
        "line": 225,
        "text": "    log(\"=== KG sync start ===\")"
      },
      {
        "line": 226,
        "text": "    tunnel = start_tunnel()"
      },
      {
        "line": 227,
        "text": "    try:"
      },
      {
        "line": 228,
        "text": "        for coll in COLLECTIONS:"
      },
      {
        "line": 229,
        "text": "            sync_collection(coll)"
      },
      {
        "line": 230,
        "text": "        sync_sqlite()"
      },
      {
        "line": 231,
        "text": "    finally:"
      },
      {
        "line": 232,
        "text": "        tunnel.terminate()"
      },
      {
        "line": 233,
        "text": "        tunnel.wait(timeout=10)"
      },
      {
        "line": 234,
        "text": "    log(\"=== KG sync complete ===\")"
      },
      {
        "line": 235,
        "text": ""
      },
      {
        "line": 236,
        "text": ""
      },
      {
        "line": 237,
        "text": "if __name__ == \"__main__\":"
      },
      {
        "line": 238,
        "text": "    try:"
      },
      {
        "line": 239,
        "text": "        main()"
      },
      {
        "line": 240,
        "text": "    except Exception as e:"
      },
      {
        "line": 241,
        "text": "        log(f\"FATAL: {e}\")"
      },
      {
        "line": 242,
