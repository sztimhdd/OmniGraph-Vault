  "sources": {
    "scripts/sync-from-aliyun.sh": [
      {
        "line": 1,
        "text": "#!/usr/bin/env bash"
      },
      {
        "line": 2,
        "text": "# scripts/sync-from-aliyun.sh"
      },
      {
        "line": 3,
        "text": "#"
      },
      {
        "line": 4,
        "text": "# Pull articles SSG output / kol_scan.db / images / kb/wiki from"
      },
      {
        "line": 5,
        "text": "# Aliyun (47.117.244.253, root) → Hermes ${HERMES_DATA_DIR}."
      },
      {
        "line": 6,
        "text": "# Runs as oneshot on Hermes (systemd timer). Pure bash + rsync + ssh."
      },
      {
        "line": 7,
        "text": "#"
      },
      {
        "line": 8,
        "text": "# Idempotent (re-run on same day = no-op transfer). Exit 0 on full"
      },
      {
        "line": 9,
        "text": "# success across all 4 targets; non-zero on any rsync failure after 3"
      },
      {
        "line": 10,
        "text": "# retries with exponential backoff (60s / 300s / 1800s)."
      },
      {
        "line": 11,
        "text": "#"
      },
      {
        "line": 12,
        "text": "# Retry exhaustion writes /tmp/aliyun-sync-failed-<date> marker per"
      },
      {
        "line": 13,
        "text": "# SYNC-04. Stale markers (any failed-<date>) are cleaned up on next"
      },
      {
        "line": 14,
        "text": "# success per FINDING 10 (prevents aim-5 STAB-03 false-trip)."
      },
      {
        "line": 15,
        "text": "#"
      },
      {
        "line": 16,
        "text": "# REQs: SYNC-01 (script + idempotency + exit semantics)"
      },
      {
        "line": 17,
        "text": "#       SYNC-04 (retry/backoff/marker logic)"
      },
      {
        "line": 18,
        "text": "#"
      },
      {
        "line": 19,
        "text": "# Aliyun side prep: aim-4-1 installed Hermes pubkey on"
      },
      {
        "line": 20,
        "text": "# /root/.ssh/authorized_keys."
      },
      {
        "line": 21,
        "text": ""
      },
      {
        "line": 22,
        "text": "set -u"
      },
      {
        "line": 23,
        "text": ""
      },
      {
        "line": 24,
        "text": "# --- Config (overridable via env) -------------------------------------"
      },
      {
        "line": 25,
        "text": "ALIYUN_SSH_HOST=\"${ALIYUN_SSH_HOST:-root@47.117.244.253}\""
      },
      {
        "line": 26,
        "text": "ALIYUN_SSH_KEY=\"${ALIYUN_SSH_KEY:-${HOME}/.ssh/hermes_to_aliyun_ed25519}\""
      },
      {
        "line": 27,
        "text": "HERMES_DATA_DIR=\"${HERMES_DATA_DIR:-${HOME}/.hermes/omonigraph-vault}\""
      },
      {
        "line": 28,
        "text": ""
      },
      {
        "line": 29,
        "text": "SSH_OPTS=\"-i ${ALIYUN_SSH_KEY} -o StrictHostKeyChecking=accept-new -o BatchMode=yes\""
      },
      {
        "line": 30,
        "text": "RSYNC_OPTS=\"-az --delete\""
      },
      {
        "line": 31,
        "text": ""
      },
      {
        "line": 32,
        "text": "# --- Sync targets: SRC (Aliyun) → DST (Hermes) ------------------------"
      },
      {
        "line": 33,
        "text": "# Order: cheapest first so a fail-fast on later targets still gets"
      },
      {
        "line": 34,
        "text": "# small early targets to disk. Verified 2026-05-24 via SSH probe."
      },
      {
        "line": 35,
        "text": "SYNC_PAIRS=("
      },
      {
        "line": 36,
        "text": "  \"/root/OmniGraph-Vault/data/kol_scan.db|${HERMES_DATA_DIR}/kol_scan.db\""
      },
      {
        "line": 37,
        "text": "  \"/root/OmniGraph-Vault/kb/wiki/|${HERMES_DATA_DIR}/kb/wiki/\""
      },
      {
        "line": 38,
        "text": "  \"/root/OmniGraph-Vault/kb/output/articles/|${HERMES_DATA_DIR}/articles/\""
      },
      {
        "line": 39,
        "text": "  \"/root/.hermes/omonigraph-vault/images/|${HERMES_DATA_DIR}/images/\""
      },
      {
        "line": 40,
        "text": ")"
      },
      {
        "line": 41,
        "text": ""
      },
      {
        "line": 42,
        "text": "# --- Helpers ----------------------------------------------------------"
      },
      {
        "line": 43,
        "text": "log() {"
      },
      {
        "line": 44,
        "text": "  echo \"[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*\""
      },
      {
        "line": 45,
        "text": "}"
      },
      {
        "line": 46,
        "text": ""
      },
      {
        "line": 47,
        "text": "ensure_parent_dirs() {"
      },
      {
        "line": 48,
        "text": "  mkdir -p \\"
      },
      {
        "line": 49,
        "text": "    \"${HERMES_DATA_DIR}/kb/wiki\" \\"
      },
      {
        "line": 50,
        "text": "    \"${HERMES_DATA_DIR}/articles\" \\"
      },
      {
        "line": 51,
        "text": "    \"${HERMES_DATA_DIR}/images\""
      },
      {
        "line": 52,
        "text": "}"
      },
      {
        "line": 53,
        "text": ""
      },
      {
        "line": 54,
        "text": "do_one_rsync() {"
      },
      {
        "line": 55,
        "text": "  local src=\"$1\" dst=\"$2\""
      },
      {
        "line": 56,
        "text": "  rsync ${RSYNC_OPTS} \\"
      },
      {
        "line": 57,
        "text": "    -e \"ssh ${SSH_OPTS}\" \\"
      },
      {
        "line": 58,
        "text": "    \"${ALIYUN_SSH_HOST}:${src}\" \\"
      },
      {
        "line": 59,
        "text": "    \"${dst}\""
      },
      {
        "line": 60,
        "text": "}"
      },
      {
        "line": 61,
        "text": ""
      },
      {
        "line": 62,
        "text": "do_rsync_all() {"
      },
      {
        "line": 63,
        "text": "  local rc=0"
      },
      {
        "line": 64,
        "text": "  for pair in \"${SYNC_PAIRS[@]}\"; do"
      },
      {
        "line": 65,
        "text": "    local src=\"${pair%%|*}\""
      },
      {
        "line": 66,
        "text": "    local dst=\"${pair##*|}\""
      },
      {
        "line": 67,
        "text": "    log \"rsync ${src} → ${dst}\""
      },
      {
        "line": 68,
        "text": "    if ! do_one_rsync \"${src}\" \"${dst}\"; then"
      },
      {
        "line": 69,
        "text": "      local code=$?"
      },
      {
        "line": 70,
        "text": "      log \"  → rsync FAILED (exit ${code}) for ${src}\""
      },
      {
        "line": 71,
        "text": "      rc=${code}"
      },
      {
        "line": 72,
        "text": "    fi"
      },
      {
        "line": 73,
        "text": "  done"
      },
      {
        "line": 74,
        "text": "  return ${rc}"
      },
      {
        "line": 75,
        "text": "}"
      },
      {
        "line": 76,
        "text": ""
      },
      {
        "line": 77,
        "text": "clean_stale_markers() {"
      },
      {
        "line": 78,
        "text": "  # FINDING 10: clear all markers on success so a transient old"
      },
      {
        "line": 79,
        "text": "  # failure does not falsely trip aim-5 STAB-03."
      },
      {
        "line": 80,
        "text": "  rm -f /tmp/aliyun-sync-failed-* 2>/dev/null || true"
      },
      {
        "line": 81,
        "text": "}"
      },
      {
        "line": 82,
        "text": ""
      },
      {
        "line": 83,
        "text": "write_failure_marker() {"
      },
      {
        "line": 84,
        "text": "  local date_str"
      },
      {
        "line": 85,
        "text": "  date_str=\"$(date +%Y-%m-%d)\""
      },
      {
        "line": 86,
        "text": "  touch \"/tmp/aliyun-sync-failed-${date_str}\""
      },
      {
        "line": 87,
        "text": "  log \"MARKER /tmp/aliyun-sync-failed-${date_str} written\""
      },
      {
        "line": 88,
        "text": "}"
      },
      {
        "line": 89,
        "text": ""
      },
      {
        "line": 90,
        "text": "# --- Main retry loop --------------------------------------------------"
      },
      {
        "line": 91,
        "text": "main() {"
      },
      {
        "line": 92,
        "text": "  ensure_parent_dirs"
      },
      {
        "line": 93,
        "text": ""
      },
      {
        "line": 94,
        "text": "  local delays=(60 300 1800)"
      },
      {
        "line": 95,
        "text": "  local attempt"
      },
      {
        "line": 96,
        "text": ""
      },
      {
        "line": 97,
        "text": "  for attempt in 0 1 2; do"
      },
      {
        "line": 98,
        "text": "    if do_rsync_all; then"
      },
      {
        "line": 99,
        "text": "      clean_stale_markers"
      },
      {
        "line": 100,
        "text": "      log \"sync OK on attempt $((attempt + 1))\""
      },
      {
        "line": 101,
        "text": "      exit 0"
      },
      {
        "line": 102,
        "text": "    fi"
      },
      {
        "line": 103,
        "text": "    local d=\"${delays[${attempt}]}\""
      },
      {
        "line": 104,
        "text": "    log \"attempt $((attempt + 1)) failed; sleeping ${d}s before retry\""
      },
      {
        "line": 105,
        "text": "    sleep \"${d}\""
      },
      {
        "line": 106,
        "text": "  done"
      },
      {
        "line": 107,
        "text": ""
      },
      {
        "line": 108,
        "text": "  # 4th and final attempt"
      },
      {
        "line": 109,
        "text": "  if do_rsync_all; then"
      },
      {
        "line": 110,
        "text": "    clean_stale_markers"
      },
      {
        "line": 111,
        "text": "    log \"sync OK on final attempt (4)\""
      },
      {
        "line": 112,
        "text": "    exit 0"
      },
      {
        "line": 113,
        "text": "  fi"
      },
      {
        "line": 114,
        "text": ""
      },
      {
        "line": 115,
        "text": "  write_failure_marker"
      },
      {
        "line": 116,
        "text": "  echo \"ERROR: aliyun sync exhausted 3 retries on $(date +%Y-%m-%d)\" >&2"
      },
      {
        "line": 117,
        "text": "  exit 1"
      },
      {
        "line": 118,
        "text": "}"
      },
      {
        "line": 119,
        "text": ""
      },
      {
        "line": 120,
        "text": "main \"$@\""
      }
    ],
